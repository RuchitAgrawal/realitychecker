# Supabase (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Groq - Primary Text LLM (Required, free tier: console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio - Gemini Vision Fallback (Optional, free tier: aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis - Response Cache (Optional, free tier: console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
